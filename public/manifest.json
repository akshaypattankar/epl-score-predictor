{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/?source=pwa",
  "name": "EPL Score Predictor",
  "short_name": "EPL Predictor",
  "description": "Track, predict and compare Premier League match scores with friends in mini-leagues.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0d0f17",
  "theme_color": "#37003c",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "sports",
    "entertainment",
    "games"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "EPL Matchweek Predictions & Standings Dashboard"
    },
    {
      "src": "/icons/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile EPL Score Predictor & Mini-Leagues"
    }
  ],
  "shortcuts": [
    {
      "name": "Predictions Dashboard",
      "short_name": "Dashboard",
      "url": "/?tab=dashboard",
      "description": "Jump to matchweek prediction dashboard",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scoring Rules",
      "short_name": "Rules",
      "url": "/?tab=rules",
      "description": "View points rules and scoring calculation",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
