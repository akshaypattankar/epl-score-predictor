# ==============================================================================
# EPL Score Predictor Environment Configuration
# ==============================================================================

# Admin credentials & system settings
ADMIN_PASSWORD=admin123
TZ=Asia/Kolkata
PORT=3000

# ------------------------------------------------------------------------------
# Prediction Accuracy Score (PAS) Weightages
# ------------------------------------------------------------------------------
# Configure the relative importance of the 3 core pillars.
# Values can be specified as decimals (0.50) or integers/percentages (50 or 50%).
# The system automatically normalizes the weights so they sum to 100%.
#
# Default formula: PAS = 50% Match Precision + 35% Rank Proximity + 15% Points Calibration
PAS_WEIGHT_MATCH=0.50       # Weight for Match Score Precision (default: 50%)
PAS_WEIGHT_RANK=0.35        # Weight for Table Rank Proximity (default: 35%)
PAS_WEIGHT_POINTS=0.15      # Weight for Points Calibration (default: 15%)

# Sub-weights for Table Rank Proximity (normalized to sum to 100%)
PAS_WEIGHT_RHO=0.60         # Weight for Spearman rank correlation rho (default: 60%)
PAS_WEIGHT_MARS=0.40        # Weight for Mean Absolute Rank Shift MARS (default: 40%)
