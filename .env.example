# ==============================================================================
# EPL Score Predictor — Environment Configuration
# ==============================================================================

# ─── Tailscale Sidecar Configuration ──────────────────────────────────────────
# Tailscale Auth Key (Generate at: https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-your-key-here

# Service name / Node hostname on your Tailnet (e.g. epl-score-predictor)
TS_SERVICE_NAME=epl-score-predictor
TS_HOSTNAME=epl-score-predictor

# Tailscale Userspace networking (set true if host lacks /dev/net/tun)
TS_USERSPACE=false

# Optional extra CLI flags for Tailscale (e.g. --accept-routes, --advertise-tags=tag:server)
TS_EXTRA_ARGS=

# Path to Tailscale Serve & Funnel JSON config (mounted in docker-compose)
# Edit config/tailscale-serve.json to configure HTTPS ports, target proxy, and Funnel flag:
# - "AllowFunnel": { "${TS_CERT_DOMAIN}:443": true }  -> Public Internet Access via Funnel
# - "AllowFunnel": { "${TS_CERT_DOMAIN}:443": false } -> Private Tailnet Access Only
TS_SERVE_CONFIG=/config/tailscale-serve.json

# ─── Backend & App Settings ───────────────────────────────────────────────────
# Directory for SQLite persistent database
DATA_DIR=/app/data

# Admin access password
ADMIN_PASSWORD=admin123
